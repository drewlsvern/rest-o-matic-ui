@inject IServiceScopeFactory Scopes

<MudDialog>
    <DialogContent>
        <EditForm id="set-password" Model="_input" OnValidSubmit="SaveAsync" FormName="set-password">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <Problems Messages="_problems" />
                <NewPasswordFields Label="New password"
                                   @bind-Password="_input.Password" @bind-Confirmation="_input.Confirmation"
                                   PasswordFor="@(() => _input.Password)" ConfirmationFor="@(() => _input.Confirmation)" />
                <MudText Typo="Typo.caption">@User.UserName will be signed out everywhere.</MudText>
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="set-password" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">Set password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private NewPasswordForm _input = new("");
    private IReadOnlyList<string> _problems = [];
    private bool _busy;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public UserSummary User { get; set; } = default!;

    protected override void OnInitialized() => _input = new NewPasswordForm(User.UserName);

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var result = await Scopes.WithAccountsAsync(accounts =>
                accounts.SetPasswordAsync(User.Id, _input.Password, _input.Confirmation));
            _problems = result.Problems;
            if (result.Succeeded)
            {
                Dialog.Close(DialogResult.Ok(true));
            }
        }
        finally
        {
            _input.Clear();
            _busy = false;
        }
    }
}
