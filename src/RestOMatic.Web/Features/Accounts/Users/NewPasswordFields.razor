@using System.Linq.Expressions
@* A new password and its confirmation, with one show/hide toggle for both. *@

<MudTextField T="string" Value="Password" ValueChanged="PasswordChanged" For="PasswordFor" Immediate="true"
              Label="@Label" Variant="Variant.Outlined" InputType="@(_show ? InputType.Text : InputType.Password)"
              Adornment="Adornment.End"
              AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              AdornmentAriaLabel="@(_show ? "Hide passwords" : "Show passwords")"
              OnAdornmentClick="() => _show = !_show"
              HelperText="@($"At least {AccountRules.PasswordMinLength} characters, with a lower-case letter, an upper-case letter, a digit and a special character.")" />
<MudTextField T="string" Value="Confirmation" ValueChanged="ConfirmationChanged" For="ConfirmationFor" Immediate="true"
              Label="@($"Confirm {Label.ToLowerInvariant()}")" Variant="Variant.Outlined"
              InputType="@(_show ? InputType.Text : InputType.Password)" />

@code {
    private bool _show;

    [Parameter]
    public string Label { get; set; } = "Password";

    [Parameter]
    public string Password { get; set; } = "";

    [Parameter]
    public EventCallback<string> PasswordChanged { get; set; }

    [Parameter]
    public string Confirmation { get; set; } = "";

    [Parameter]
    public EventCallback<string> ConfirmationChanged { get; set; }

    [Parameter, EditorRequired]
    public Expression<Func<string>> PasswordFor { get; set; } = default!;

    [Parameter, EditorRequired]
    public Expression<Func<string>> ConfirmationFor { get; set; } = default!;
}
