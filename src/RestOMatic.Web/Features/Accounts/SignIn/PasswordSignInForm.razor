@using System.ComponentModel.DataAnnotations
@inject SignInHandler Handler
@inject NavigationManager Navigation

<EditForm Model="_input" OnValidSubmit="SignInAsync" FormName="password-sign-in">
    <DataAnnotationsValidator />
    <MudStack Spacing="3">
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" data-testid="sign-in-error">@_error</MudAlert>
        }
        <MudTextField @bind-Value="_input.UserName" For="@(() => _input.UserName)" Immediate="true"
                      Label="User name" Variant="Variant.Outlined" AutoFocus="true" />
        <MudTextField @bind-Value="_input.Password" For="@(() => _input.Password)" Immediate="true"
                      Label="Password" Variant="Variant.Outlined"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                      OnAdornmentClick="() => _showPassword = !_showPassword" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   FullWidth="true" Disabled="@(_busy || !RendererInfo.IsInteractive)">Sign in</MudButton>
    </MudStack>
</EditForm>

@code {
    private Input _input = new();
    private string? _error;
    private bool _showPassword;
    private bool _busy;

    [Parameter, EditorRequired]
    public SignInContext Context { get; set; } = default!;

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var outcome = await Handler.SignInAsync(
                _input.UserName, _input.Password, Context.ClientAddress, Context.BrowserBinding, Context.ReturnUrl);
            switch (outcome)
            {
                case SignInOutcome.Succeeded succeeded:
                    Navigation.NavigateTo(succeeded.CompletionUrl, forceLoad: true);
                    break;
                case SignInOutcome.Refused refused:
                    _error = refused.Message;
                    break;
            }
        }
        finally
        {
            // The password is not kept in the circuit for longer than one
            // attempt. A new model also clears the empty field's "required"
            // message, which would otherwise show after every failure.
            _input = new Input { UserName = _input.UserName };
            _busy = false;
        }
    }

    private sealed class Input
    {
        [Required(ErrorMessage = "Enter your user name.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
