@inherits LayoutComponentBase

@* For the pages seen before signing in: no app bar or navigation, the
   content centred on the screen. *@

<MudThemeProvider Theme="AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="centred-layout" data-testid="centred-layout">
    <main class="centred-layout-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
