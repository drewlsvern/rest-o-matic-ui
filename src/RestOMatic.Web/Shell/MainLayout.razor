@inherits LayoutComponentBase
@using RestOMatic.Web.Features.Accounts.Profile

<MudThemeProvider Theme="AppTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <a href="/" class="app-bar-home">
            <img src="images/rest-o-matic-mark.svg" alt="" class="app-bar-logo" />
            <MudText Typo="Typo.h6">rest-o-matic</MudText>
        </a>
        <MudButton Href="/hosts" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Dns" Class="ml-6 text-none">Hosts</MudButton>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="mr-4">@AppVersion.Current</MudText>
        <ProfileMenu />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
